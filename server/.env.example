# Copy to server/.env and adjust. Never commit server/.env.
# Every variable is documented in the root README ("Environment variables").

# Port the API listens on. 5001 avoids macOS AirPlay Receiver, which occupies 5000.
PORT=5001

# development | test | production
NODE_ENV=development

# Exact origin of the frontend allowed to call the API (with cookies).
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection for the app (local database created in database/README.md).
DATABASE_URL=postgres://velo:velo_dev_password@localhost:5432/velo_dev

# Separate database used by the test suite and `npm run db:reset:test`. Never point at dev data.
TEST_DATABASE_URL=postgres://velo:velo_dev_password@localhost:5432/velo_test

# Secret used to sign session tokens (JWT). At least 32 characters, random, never shared.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
